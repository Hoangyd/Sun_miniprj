{
  "info": {
    "name": "Employee Management API",
    "description": "Module 4 - Spring Boot + JPA API Collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Employees",
      "item": [
        {
          "name": "Get All Employees",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/employees",
              "host": ["{{baseUrl}}"],
              "path": ["employees"]
            }
          }
        },
        {
          "name": "Get Employee by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/employees/1",
              "host": ["{{baseUrl}}"],
              "path": ["employees", "1"]
            }
          }
        },
        {
          "name": "Get Employee by Ma Nhan Vien",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/employees/ma/EMP-001",
              "host": ["{{baseUrl}}"],
              "path": ["employees", "ma", "EMP-001"]
            }
          }
        },
        {
          "name": "Search Employee by Name",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/employees/search?ten=hoang",
              "host": ["{{baseUrl}}"],
              "path": ["employees", "search"],
              "query": [
                {
                  "key": "ten",
                  "value": "hoang"
                }
              ]
            }
          }
        },
        {
          "name": "Search Employee by Department",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/employees/department/1",
              "host": ["{{baseUrl}}"],
              "path": ["employees", "department", "1"]
            }
          }
        },
        {
          "name": "Advanced Search (Name + Department)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/employees/search-advanced?ten=hoang&departmentId=1",
              "host": ["{{baseUrl}}"],
              "path": ["employees", "search-advanced"],
              "query": [
                {
                  "key": "ten",
                  "value": "hoang"
                },
                {
                  "key": "departmentId",
                  "value": "1"
                }
              ]
            }
          }
        },
        {
          "name": "Create Employee",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ten\": \"Phạm Minh Đức\",\n  \"email\": \"duc.pham@company.com\",\n  \"department\": {\n    \"id\": 1\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/employees",
              "host": ["{{baseUrl}}"],
              "path": ["employees"]
            }
          }
        },
        {
          "name": "Update Employee",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ten\": \"Phạm Minh Đức Updated\",\n  \"email\": \"duc.updated@company.com\",\n  \"department\": {\n    \"id\": 2\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/employees/1",
              "host": ["{{baseUrl}}"],
              "path": ["employees", "1"]
            }
          }
        },
        {
          "name": "Delete Employee",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/employees/1",
              "host": ["{{baseUrl}}"],
              "path": ["employees", "1"]
            }
          }
        }
      ]
    },
    {
      "name": "Departments",
      "item": [
        {
          "name": "Get All Departments",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/departments",
              "host": ["{{baseUrl}}"],
              "path": ["departments"]
            }
          }
        },
        {
          "name": "Get Department by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/departments/1",
              "host": ["{{baseUrl}}"],
              "path": ["departments", "1"]
            }
          }
        },
        {
          "name": "Get Department by Name",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/departments/name/IT",
              "host": ["{{baseUrl}}"],
              "path": ["departments", "name", "IT"]
            }
          }
        },
        {
          "name": "Create Department",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Finance\",\n  \"description\": \"Finance Department\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/departments",
              "host": ["{{baseUrl}}"],
              "path": ["departments"]
            }
          }
        },
        {
          "name": "Update Department",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Finance Updated\",\n  \"description\": \"Updated description\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/departments/1",
              "host": ["{{baseUrl}}"],
              "path": ["departments", "1"]
            }
          }
        },
        {
          "name": "Delete Department",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/departments/1",
              "host": ["{{baseUrl}}"],
              "path": ["departments", "1"]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081",
      "type": "string"
    }
  ]
}
